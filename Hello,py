while True:
    try:
        num1 = int(input("Please enter the first number: "))
        break
    except ValueError:
        print("Invalid number! Try again.")

while True:
    try:
        num2 = int(input("Please enter the second number: "))
        break
    except ValueError:
        print("Invalid number! Try again.")

print("1. Add")
print("2. Subtract")
print("3. Multiply")
print("4. Divide")

choice = input("Choose an operation: ")

if choice == "1":
    result = num1 + num2
    print("Result:", result)

elif choice == "2":
    result = num1 - num2
    print("Result:", result)

elif choice == "3":
    result = num1 * num2
    print("Result:", result)

elif choice == "4":
    if num2 == 0:
        print("Cannot divide by zero!")
    else:
        result = num1 // num2
        print("Result:", result)

else:
    print("Invalid choice")
